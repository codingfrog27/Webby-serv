	"version": "0.2.0",
	"configurations": [
		
		{
			"name": "webserv",
			"type": "cppdbg",
			"request": "launch",
			"program": "/home/mde-cloe/PROJECTS/WEBSERV/Webby-serv/webserv",
			"args": ["example_config.conf"],
			"stopAtEntry": false,
			"cwd": "/home/mde-cloe/PROJECTS/WEBSERV/Webby-serv/",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Enable pretty-printing for gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				},
				{
					"description": "Set Disassembly Flavor to Intel",
					"text": "-gdb-set disassembly-flavor intel",
					"ignoreFailures": true
				}
			]
		}


	]
